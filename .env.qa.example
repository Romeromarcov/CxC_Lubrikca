# Entorno de pruebas (Fase 3 del plan de blindaje) -- NUNCA produccion.
#
# Copia a `.env.qa` y completa. `.env.qa` no se versiona (ver .gitignore).
# `scripts/qa_entorno.py` se niega a correr si DATABASE_URL no es local o si
# ODOO_URL no lleva `.dev.odoo.com`.

# --- Odoo de prueba (duplicado de la base real) -------------------------------
ODOO_URL=https://<tu-entorno>.dev.odoo.com
ODOO_DB=<tu-entorno>
ODOO_USERNAME=<correo>
ODOO_PASSWORD=<api-key del entorno de prueba>

# --- Espejo local, separado del de CI -----------------------------------------
DATABASE_URL=postgresql://cxc:cxc_ci_pw@localhost:5432/cxc_qa

# --- Motor: mismas listas que produccion --------------------------------------
ENGINE_LISTA_USD=4
ENGINE_LISTA_BCV=5
ODOO_PRICELIST_USD=4
ODOO_PRICELIST_BCV=5

CASH_WINDOW_BUSINESS_DAYS=3
BCV_COMPLETE_FORMULA=differential_over_binance
RECON_TOLERANCE_ROUNDING=0.01
RECON_TOLERANCE_RED=1.00
HOUR_AUDIT_THRESHOLD_MINUTES=60
HOUR_AUDIT_RATE_SWING_PCT=0.03

# --- Scraper: apagado en QA, las tasas se siembran desde el espejo -------------
BINANCE_P2P_URL=https://p2p.binance.com/bapi/c2c/v2/friendly/c2c/adv/search
BINANCE_P2P_ASSET=USDT
BINANCE_P2P_FIAT=VES
BINANCE_P2P_TRADE_TYPE_BUY=BUY
BINANCE_P2P_TRADE_TYPE_SELL=SELL
BINANCE_P2P_ROWS=5
BINANCE_P2P_ADV_LIST_PATH=data
BINANCE_P2P_PRICE_PATH=adv.price
BCV_URL=https://www.bcv.org.ve/
SCRAPER_FAIL_ALERT_THRESHOLD=3
