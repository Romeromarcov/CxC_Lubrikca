# =============================================================================
# Sistema de Cobros y Conciliación Lubrikca (CxC) — Plantilla de configuración
# =============================================================================
# Copia este archivo a `.env` y rellena los valores reales.
# El `.env` real NUNCA se versiona (ver .gitignore). No hay secretos en el repo.
# Toda la configuración del sistema entra por variables de entorno.
# -----------------------------------------------------------------------------

# --- Odoo (XML-RPC) — el sync y el motor SOLO LEEN de Odoo --------------------
ODOO_URL=https://miempresa.odoo.com
ODOO_DB=miempresa
ODOO_USERNAME=integracion@miempresa.com
# Usar API key de Odoo, no la contraseña de un humano.
ODOO_PASSWORD=cambia-esto

# --- Google Sheets (espejo de Odoo + tablas de trabajo) ----------------------
GOOGLE_SHEETS_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789
# Ruta al JSON de la service account de Google. Fuera del repo.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service_account.json

# --- Scraper Binance P2P -----------------------------------------------------
# IMPORTANTE: estructura/URL parametrizada aquí. Binance cambia de formato;
# este es el ÚNICO punto de ajuste. La lógica no hardcodea nada de esto.
BINANCE_P2P_URL=https://p2p.binance.com/bapi/c2c/v2/friendly/c2c/adv/search
BINANCE_P2P_ASSET=USDT
BINANCE_P2P_FIAT=VES
BINANCE_P2P_TRADE_TYPE_BUY=BUY
BINANCE_P2P_TRADE_TYPE_SELL=SELL
BINANCE_P2P_PAY_TYPES=
BINANCE_P2P_ROWS=5
# Ruta (dot-path) dentro del JSON de respuesta hacia la lista de anuncios y el precio.
BINANCE_P2P_ADV_LIST_PATH=data
BINANCE_P2P_PRICE_PATH=adv.price
BINANCE_REQUEST_TIMEOUT_SECONDS=20

# --- Scraper BCV -------------------------------------------------------------
BCV_URL=https://www.bcv.org.ve/
BCV_REQUEST_TIMEOUT_SECONDS=20
# Selector/patrón para extraer la tasa USD del HTML del BCV (parametrizable).
BCV_USD_REGEX=id="dolar".*?<strong>\s*([\d.,]+)\s*</strong>

# --- Política del scraper ----------------------------------------------------
# Nº de fallos consecutivos que disparan alerta (sección 5.3).
SCRAPER_FAIL_ALERT_THRESHOLD=3

# --- Alertas (fallback / desvíos) --------------------------------------------
# Telegram opcional; si vacío, las alertas solo se loguean.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_TELEGRAM_API_URL=https://api.telegram.org

# --- Motor de descuentos -----------------------------------------------------
# Días hábiles de la ventana de contado (sección 4.6).
CASH_WINDOW_BUSINESS_DAYS=3
# Fórmula del descuento BCV-completo (ver TODO.md). Default conservador:
#   diferencial = (binance - bcv) / binance  por abono.
BCV_COMPLETE_FORMULA=differential_over_binance
# Nombres reales de las pricelists en Odoo a las que el motor reselecciona.
ENGINE_LISTA_USD=USD
ENGINE_LISTA_BCV=BCV

# --- Conciliación (semáforo, sección 7) --------------------------------------
# |dif| <= ROUNDING -> verde ; <= RED -> amarillo ; > RED -> rojo.
RECON_TOLERANCE_ROUNDING=0.01
RECON_TOLERANCE_RED=1.00

# --- Auditoría hora declarada vs banco (sección 6.3) -------------------------
# Umbral en minutos para marcar un desvío de hora.
HOUR_AUDIT_THRESHOLD_MINUTES=60
# Umbral de swing de tasa Binance (%) que marca un abono aunque la hora calce.
HOUR_AUDIT_RATE_SWING_PCT=0.03
